{% include "hexcasting:index.css.jinja" %}

/* i saw your cry for help, whoever wrote that comment in hexdoc */
.navbar-default .navbar-brand,
.navbar-default .navbar-nav > li > a,
.navbar-default .navbar-nav > li > a:focus {
  color: #ddd;
}

.navbar-default .navbar-nav > .open > a,
.navbar-default .navbar-nav > .open > a:focus,
@media (prefers-color-scheme: dark) {
  .dropdown-menu {
    background-color: #749bff;
    min-width: 120px;
  }
  .navbar-default .navbar-nav > .open > a:hover {
    color: #bbb;
    background-color: #1e3469;
  }

  .dropdown-menu {
    background-color: #0c152b;
    min-width: 120px;
  }

  body {
    background-color: #0c1031;
    color: #ddd;
    .navbar-default {
      background-color: #0b1f51;
      border-color: #fff;
    }
  }
}

@media (prefers-color-scheme: light) {
  .dropdown-menu {
    background-color: #3a4d7e;
    min-width: 120px;
  }
  .navbar-default .navbar-nav > .open > a:hover {
    color: #111;
    background-color: #7399fa;
  }

  .dropdown-menu {
    color: #111;
    background-color: #7399fa;
    min-width: 120px;
  }

  body {
    background-color: #5963bd;
    color: #111;
    .navbar-default {
      background-color: #2c51ad;
      border-color: #111;
    }
  }
}